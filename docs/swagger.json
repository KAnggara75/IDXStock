                "annual_dividend": {
                    "type": "number"
                },
                "board": {
                    "type": "string"
                },
                "code": {
                    "type": "string"
                },
                "delisting_date": {
                    "type": "string"
                },
                "founding_date": {
                    "type": "string"
                },
                "general_information": {
                    "type": "string"
                },
                "industry_id": {
                    "type": "integer"
                },
                "last_modified": {
                    "type": "string"
                },
                "listing_date": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "sector_id": {
                    "type": "integer"
                },
                "shares": {
                    "type": "integer"
                },
                "sub_industry_id": {
                    "type": "integer"
                },
                "sub_sector_id": {
                    "type": "integer"
                },
                "total_employees": {
                    "type": "string"
                }
            }

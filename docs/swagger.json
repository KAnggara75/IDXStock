                },
                "freq": {
                    "type": "integer"
                },
                "lot": {
                    "type": "integer"
                },
                "side": {
                    "description": "\"buy\" or \"sell\"",
                    "type": "string"
                },
                "stock_code": {
                    "type": "string"
                },
                "value": {
                    "type": "integer"
                }
            }
        },
        "models.ErrorResponse": {
            "type": "object",
            "properties": {

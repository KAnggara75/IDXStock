                    "type": "string"
                }
            }
        },
        "models.IdxDelistedStock": {
            "type": "object",
            "properties": {
                "DeListingDate": {
                    "type": "string"
                },
                "code": {
                    "type": "string"
                }
            }
        },
        "models.IndustrySyncResponse": {
            "type": "object",
            "properties": {
                "industries": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.BasicResponse"
                    }
                },
                "sub_industries": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.BasicResponse"
                    }
                }
            }
        },
        "models.SectorSyncNewResponse": {
            "type": "object",
            "properties": {
                "sectors": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.BasicResponseWithCode"
                    }
                },
                "sub_sectors": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/models.BasicResponseWithCode"
                    }
                }
            }
        },
        "models.Stock": {
            "type": "object",
            "properties": {
                "annual_dividend": {
                    "type": "number"
                },
                "code": {
                    "type": "string"
                },
                "company_name": {
                    "type": "string"
                },
                "delisting_date": {
                    "type": "string"
                },
                "founding_date": {
                    "type": "string"
                },
                "general_information": {
                    "type": "string"
                },
                "id": {
                    "type": "integer"
                },
                "industry_id": {
                    "type": "integer"
                },
                "listing_board": {
